recompiler.py
recompile_wii.py
func_discovery.py
ppc_disasm.py
elf_parser.py
elf_loader.py
dol_loader.py
rso_loader.py
hle_name_map.py
gen_modules_h.py
sig_scan.py
apply_music_hooks.py
regen_robox.sh
templates/
func_list.json
hle_registry.json
module_manifest.json
recompile_manifest.json
extra_funcs.json
identified_funcs.json
robox_matched_names.json
dol_info.json
string_xrefs.json
align_proposals.json
recomp_config.json
recomp_config.example.json

# --- recompiled game code ---------------------------------------------------
# A line-by-line translation of the retail executable, and therefore a
# derivative of it exactly as Robox USA.dol is. Not committed; generated at
# configure time from the user's own copy of the game. See the
# ROBOX_RECOMPILER / ROBOX_DOL block in CMakeLists.txt.
#
# Note this must come AFTER any src/generated_setup rule and be spelled with
# the trailing slash, or it will not match what you think it matches.
src/generated/

# Where you drop your own game executable for the build to recompile from,
# named to match UnleashedRecompLib/private/. Anchored with a leading slash:
# unanchored it also swallowed discord-rpc's Private/ source directories,
# which are vendored third-party code that must stay tracked.
/private/

# --- leftovers from the previous port ---------------------------------------
# This tree started as a Rabbids Go Home recomp. Nothing named rgh* is used by
# this build (CMake takes robox.rc), and some of it carries absolute paths from
# a machine that is not yours.
rgh*.rc
rgh_icon_*.ico
rgh_recomp_handoff.md
rgh_sig_matches.json
scan_rgh_bf.py

# --- one-shot patch scripts, all superseded ---------------------------------
# Two kinds, neither of which should ship:
#
# 1. Post-processing patches over src/generated/. Every one of these fixes now
#    lives in recompiler.py itself, so a fresh regen already emits the correct
#    form and re-running them would at best be a no-op:
#      fix_fmadd_order   -> recompiler.py:1277  A-form operand order
#      fix_psq_r0base    -> recompiler.py:1541  gpr_or_zero for psq_lx/stx
#      fix_fpr           -> ps1_dup, all 14 single-precision mnemonics
#      fix_bctr_tailcall -> recompiler.py:383   PPC_TAIL ppc_jump_indirect
#      fix_bctr_switch   -> recompiler.py:332 + recompile_wii.py:830
#
# 2. One-time edits to sdk/ sources, long since applied. These are actively
#    DANGEROUS to run now: fix_gl.py truncates sdk/gx_ogl.c at the line
#    `static GLuint crash_prog = 0;` (still present, so it would delete every
#    line after it), and fix_bink_sync.py targets sdk/bink_hle.c, which no
#    longer exists.
fix_*.py
add_fps.py
append_gl.py
restore_probe.py

# --- vendored SDL for the 3DS target ----------------------------------------
# 70 MB of upstream SDL, unmodified and re-downloadable. The 3DS build needs it
# present; fetch it rather than carrying it in history.
SDL-3DS-master/

# --- build output / intermediates -------------------------------------------
# .3dsx is a built 3DS executable. The .ogg files under Setup/ and splash/ are
# an intermediate step between the .wav masters and the .rbxs the build bakes
# in -- only the .rbxs are needed.
*.3dsx
Setup/*.ogg
splash/*.ogg
Robox Soundheader test.rbxs

# --- local dev scripts ------------------------------------------------------
# Ad-hoc analysis and dump tooling. Every one of these has absolute paths from
# the author's own machine hardcoded in it, and most point at the previous
# project entirely. Nothing in the build refers to any of them.
#
# If one of these ever becomes worth publishing, strip the hardcoded paths and
# take it off this list deliberately -- do not just add it back.
analyze_*.py
create_tester.py
debug_font.py
extract_font.py
gen_html.py
run_smoke*.ps1
tools/compare_dumps.py
tools/dolphin_*.py
tools/modding/

